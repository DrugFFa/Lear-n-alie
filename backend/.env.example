# Lear(n)alie Backend Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Supabase PostgreSQL / Local PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/learnalie?schema=public"

# Authentication & Security
AUTH_SECRET="your_very_secure_and_long_jwt_secret_key_minimum_32_characters"
FRONTEND_ORIGIN="http://localhost:5173"

# Default Initial Admin Credentials (used during prisma seed)
INITIAL_ADMIN_EMAIL="admin@learnalie.com"
INITIAL_ADMIN_NAME="Learnalie Administrator"
INITIAL_ADMIN_PASSWORD="AdminLearnalie123!"
