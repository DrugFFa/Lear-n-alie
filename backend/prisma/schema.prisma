// Prisma Schema for Lear(n)alie v1.1

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum VideoStatus {
  DRAFT
  PUBLISHED
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  roleId       String?
  role         Role?         @relation(fields: [roleId], references: [id], onDelete: SetNull)
  status       AccountStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([email])
  @@index([status])
  @@index([roleId])
  @@map("users")
}

model Role {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  users       User[]
  videoRoles  VideoRole[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("roles")
}

model Category {
  id            String     @id @default(uuid())
  name          String
  slug          String     @unique
  parentId      String?
  parent        Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subcategories Category[] @relation("CategoryHierarchy")
  videos        Video[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

model Video {
  id           String      @id @default(uuid())
  title        String
  slug         String      @unique
  youtubeUrl   String
  youtubeId    String
  description  String
  categoryId   String
  category     Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status       VideoStatus @default(DRAFT)
  allowedRoles VideoRole[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([slug])
  @@index([status])
  @@index([categoryId])
  @@map("videos")
}

model VideoRole {
  videoId String
  roleId  String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  role    Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([videoId, roleId])
  @@index([roleId])
  @@index([videoId])
  @@map("video_roles")
}
